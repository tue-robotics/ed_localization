<?xml version="1.0"?>
<class_libraries>
  <!-- ROS 2 pluginlib resolves these itself by searching lib/ and lib/ed_localization/, so the path is
       the bare library name: no "lib" prefix and no directory (a ROS 1 "lib/libfoo" path is not found). -->
  <library path="ed_localization_plugin">
    <class name="ed_localization/localization" type="LocalizationPlugin" base_class_type="ed::Plugin">
      <description>Plugin to localize the robot with th use of laser scans and AMCL.</description>
    </class>
  </library>
  <library path="ed_localization_tf_plugin">
    <class name="ed_localization/localization_tf" type="LocalizationTFPlugin" base_class_type="ed::Plugin">
      <description>Plugin set robot entity pose based on TF.</description>
    </class>
  </library>
</class_libraries>
